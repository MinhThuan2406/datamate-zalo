# Copy thành .env (đã nằm trong .gitignore) rồi điền key.
OPENROUTER_API_KEY=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.5-9b

# Chỉ dùng đúng một endpoint: PrimeIntellect bf16, không cho OpenRouter chuyển sang provider khác.
# Map sang request: extra_body={"provider": {"only": ["primeintellect/bf16"], "allow_fallbacks": false}}
LLM_PROVIDER=primeintellect/bf16
LLM_ALLOW_FALLBACKS=false

# PrimeIntellect KHÔNG hỗ trợ `seed` -> chỉ dựa vào temperature=0 + cache để ổn định kết quả.
LLM_TEMPERATURE=0
# max_completion_tokens của endpoint này là 40960
LLM_MAX_TOKENS=8192

# Suy luận (reasoning) gửi qua trường `reasoning` của OpenRouter: off | low | medium | high. Để trống = không gửi.
# Đã đo trên endpoint PrimeIntellect: không gửi hoặc off -> 0 reasoning token; low -> bật suy luận.
LLM_REASONING=
# Cache phản hồi LLM trên đĩa (cache/llm). Đặt 0 để tắt cache.
LLM_CACHE=1
# Số lượt tối đa của solver react mỗi câu (CLI --max-turns ghi đè).
AGENT_MAX_TURNS=8
